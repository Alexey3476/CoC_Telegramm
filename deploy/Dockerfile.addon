FROM python:3.11-slim-bookworm
ARG BUILD_VERSION=0.1.0
LABEL io.hass.version="${BUILD_VERSION}" io.hass.type="app" io.hass.arch="aarch64|amd64"

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /opt
COPY backend/requirements.txt /tmp/backend-requirements.txt
COPY bot/requirements.txt /tmp/bot-requirements.txt
RUN pip install --no-cache-dir -r /tmp/backend-requirements.txt -r /tmp/bot-requirements.txt && mkdir -p /data
COPY backend /opt/backend
COPY bot /opt/bot
COPY coc_telegram/launcher.py /opt/launcher.py
RUN useradd --create-home --uid 1000 coc && chown -R coc:coc /opt /data
USER coc
CMD ["python", "/opt/launcher.py"]
